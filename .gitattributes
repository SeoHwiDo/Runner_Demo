# Normalize text files while leaving unknown binary files untouched.
* text=auto

*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.xml text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unreal Engine packages. LFS stores the binary while the custom diff driver
# can ask Unreal Editor to compare local package revisions.
*.uasset filter=lfs diff=uasset merge=lfs -text
*.umap filter=lfs diff=uasset merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text

