*.o
*.obj
*.gch
*.pch
*.pdb
*.ilk
*.exp
*.log

# Local tools, reports, and scratch data
/tmp/
*.tmp
*.temp
*.bak
*.orig

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local Unreal/VR editor bindings
/Config/steamvr_ue_editor_app.json
/Config/SteamVRBindings/
/Platforms/HoloLens/Config/HoloLensEngine.ini

