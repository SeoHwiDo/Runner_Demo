/Builds/

# Generated plugin output
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/DerivedDataCache/
Plugins/*/Saved/

# Keep project-owned Build resources, but ignore generated build output
/Build/**
!/Build/
!/Build/**/
!/Build/**/*.ico
!/Build/**/PakBlacklist*.txt

